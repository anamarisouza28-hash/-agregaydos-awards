# Copie para .env.local (no seu computador) ou cadastre na Vercel (Settings → Environment Variables)

# Endereço do banco no Supabase: Project Settings → Database → Connection string → "Transaction pooler"
# Troque [YOUR-PASSWORD] pela senha do banco que você criou.
DATABASE_URL=postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Senha da área de admin (escolha uma senha forte, só você sabe)
ADMIN_PASSWORD=troque-esta-senha
